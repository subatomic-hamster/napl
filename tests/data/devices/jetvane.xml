<!-- Jet vane bench: a hinge rotor (thrust +z, exhaust -z) on a vertical slide carrier, no ESC (set the shaft qvel by hand), a flat
     plate hinged about y below it (flap, aero-centre site with chord z = world -z and normal x = world +x at zero deflection),
     no gravity, no environment device (ISA at origin altitude 0). EDF-like numbers are test values, not a part claim. The
     carrier is the rotor's stator_body (swirl recovery 0.8). -->
<mujoco model="jetvane">
  <option timestep="0.001" gravity="0 0 0"/>
  <worldbody>
    <body name="carrier" pos="0 0 1">
      <joint name="lift" type="slide" axis="0 0 1"/>
      <geom type="sphere" size="0.001" mass="0.5" contype="0" conaffinity="0"/>
      <body name="rotor">
        <joint name="shaft" type="hinge" axis="0 0 1"/>
        <geom type="sphere" size="0.001" mass="0.01" contype="0" conaffinity="0"/>
      </body>
      <body name="plate" pos="0 0 -0.1">
        <joint name="flap" type="hinge" axis="0 1 0"/>
        <geom type="sphere" size="0.001" mass="0.01" contype="0" conaffinity="0"/>
        <site name="aero" pos="0 0 -0.02" quat="0 1 0 0"/>
      </body>
    </body>
  </worldbody>
  <custom>
    <text name="napl.devices" data='{
      "rotors": [{"name": "fan", "body": "rotor", "joint": "shaft", "diameter": 0.08, "dir": 1,
                  "j": [0, 1.0], "ct": [1.3, 0.3], "cq": [0.2, 0.1], "stator_body": "carrier", "swirl_recovery": 0.8,
                  "parts": ["test-fan"]}],
      "jet_vanes": [{"name": "vane", "body": "plate", "site": "aero", "rotor": "fan", "area": 0.0012, "exit_area": 0.0045,
                     "cn_alpha": 2.0, "cn_max": 1.2, "cd0": 0.05, "jet_factor": 0.9, "parts": ["test-vane"]}]
    }'/>
  </custom>
</mujoco>
