<!-- Environment (origin altitude 0, no turbulence) + body drag on a free body 100 m up. -->
<mujoco model="env">
  <option timestep="0.001" gravity="0 0 0"/>
  <worldbody>
    <body name="blob" pos="0 0 100">
      <freejoint name="fj"/>
      <geom type="sphere" size="0.05" mass="1" contype="0" conaffinity="0"/>
    </body>
  </worldbody>
  <custom>
    <text name="napl.devices" data='{
      "environments": [{"name": "air"}],
      "body_drags": [{"name": "drag", "body": "blob", "cd": 1.1, "area": 0.04}]
    }'/>
  </custom>
</mujoco>
