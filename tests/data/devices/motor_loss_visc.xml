<!-- motor.xml with a purely viscous no-load loss (i0_visc = 1): tau_loss = Kt I0 w / w0, w0 = 300 rad/s. -->
<mujoco model="motor_loss_visc">
  <option timestep="0.001" gravity="0 0 0"/>
  <worldbody>
    <body name="rotor" pos="0 0 0.1">
      <joint name="shaft" type="hinge" axis="0 0 1"/>
      <geom type="sphere" size="0.001" mass="0.001"/>
    </body>
  </worldbody>
  <custom>
    <text name="napl.devices" data='{
      "psus": [{"name": "bench", "node": 1, "voltage": 16, "r_series": 0.001}],
      "escs": [{"name": "m1", "node": 1, "joint": "shaft",
                "motor": {"kv": 920, "r20": 0.117, "i0": 0.5, "rotor_inertia": 3e-5, "c_th": 20, "r_th": 3,
                          "i0_w": 300, "i0_visc": 1.0}}]
    }'/>
  </custom>
</mujoco>
