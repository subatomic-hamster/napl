<!-- Servo on a 3.5 V supply, below its min_voltage of 4.0 V (part feetech-sts3215-c001 v_operating_min): the voltage alarm
     (bit 1) is raised without unloading (unload_mask 36 = temperature + overload; the mask is estimated, see servo_protect.xml). -->
<mujoco model="servo_lowv">
  <compiler angle="radian"/>
  <option timestep="0.001" gravity="0 0 0"/>
  <worldbody>
    <body name="link" pos="0 0 0.1">
      <joint name="out" type="hinge" axis="0 0 1"/>
      <geom type="capsule" fromto="0 0 0 0.1 0 0" size="0.01" mass="0.05" contype="0" conaffinity="0"/>
    </body>
  </worldbody>
  <custom>
    <text name="napl.devices" data='{
      "psus": [{"name": "bench", "node": 1, "voltage": 3.5, "r_series": 0.05}],
      "servos": [{"name": "s1", "node": 1, "joint": "out",
                  "motor": {"kv": 2100, "r20": 4.4, "i0": 0.05, "rotor_inertia": 5e-8, "w_s": 50, "c_th": 10, "r_th": 15},
                  "gear_ratio": 345, "efficiency": 0.7, "encoder_cpr": 4096, "firmware_hz": 100,
                  "p": 32, "i": 2, "d": 32, "pid_scale": 8192, "deadband": 0, "max_torque": 1000,
                  "min_voltage": 4.0, "max_voltage": 8.0, "max_temp": 70,
                  "overload_load": 0.8, "overload_time": 2.0, "unload_mask": 36}]
    }'/>
  </custom>
</mujoco>
