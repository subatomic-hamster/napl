<!-- IMU on a body that spins about the vertical hinge "spin" (set its qvel by hand) with the site 0.3 m off the axis, in
     gravity. The site frame is the body frame turned 90 deg about z (site x = body y, site y = -body x). The site is
     held by the hinge: its acceleration is the centripetal one only, so the IMU reads (0, w^2 r, g) in the site frame.
     Zero damping: w stays constant to rounding. -->
<mujoco model="imu_spin">
  <option timestep="0.001"/>
  <worldbody>
    <body name="rotor" pos="0 0 1">
      <joint name="spin" type="hinge" axis="0 0 1"/>
      <geom type="sphere" size="0.01" pos="0.3 0 0" mass="0.5" contype="0" conaffinity="0"/>
      <site name="s" pos="0.3 0 0" euler="0 0 90"/>
    </body>
  </worldbody>
  <custom>
    <text name="napl.devices" data='{
      "imus": [{"name": "imu", "site": "s", "rate_hz": 1000, "gyro": {}, "accel": {}}]
    }'/>
  </custom>
</mujoco>
