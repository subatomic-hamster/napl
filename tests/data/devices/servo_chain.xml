<!-- Two servos daisy-chained on one bus: PSU (node 1) -> wire w1 -> servo sa (node 2) -> wire w2 -> servo sb (node 3).
     sb has a motor-current limit (2 A); sa has none. Zero gravity. Used for KCL / regen and determinism tests. -->
<mujoco model="servo_chain">
  <option timestep="0.001" gravity="0 0 0"/>
  <worldbody>
    <body name="la" pos="0 0 0.1">
      <joint name="ja" type="hinge" axis="0 0 1"/>
      <geom type="capsule" fromto="0 0 0 0.1 0 0" size="0.01" mass="0.05" contype="0" conaffinity="0"/>
    </body>
    <body name="lb" pos="0.3 0 0.1">
      <joint name="jb" type="hinge" axis="0 0 1"/>
      <geom type="capsule" fromto="0 0 0 0.1 0 0" size="0.01" mass="0.05" contype="0" conaffinity="0"/>
    </body>
  </worldbody>
  <custom>
    <text name="napl.devices" data='{
      "psus": [{"name": "bench", "node": 1, "voltage": 12, "r_series": 0.05}],
      "wires": [{"name": "w1", "a": 1, "b": 2, "resistance": 0.2}, {"name": "w2", "a": 2, "b": 3, "resistance": 0.3}],
      "servos": [
        {"name": "sa", "node": 2, "joint": "ja",
         "motor": {"kv": 2100, "r20": 4.4, "i0": 0.05, "rotor_inertia": 5e-8, "w_s": 50, "c_th": 10, "r_th": 15},
         "gear_ratio": 345, "efficiency": 0.7, "encoder_cpr": 4096, "firmware_hz": 100,
         "p": 32, "i": 2, "d": 32, "pid_scale": 8192, "deadband": 0, "max_torque": 1000},
        {"name": "sb", "node": 3, "joint": "jb", "i_limit": 2,
         "motor": {"kv": 2100, "r20": 4.4, "i0": 0.05, "rotor_inertia": 5e-8, "w_s": 50, "c_th": 10, "r_th": 15},
         "gear_ratio": 345, "efficiency": 0.7, "encoder_cpr": 4096, "firmware_hz": 100,
         "p": 32, "i": 2, "d": 32, "pid_scale": 8192, "deadband": 0, "max_torque": 1000}]
    }'/>
  </custom>
</mujoco>
