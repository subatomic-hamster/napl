<!-- Dryden turbulence: W20 = 10 m/s, steady wind 20 m/s along +x, reference height 3.05 m (10 ft, the low clamp). -->
<mujoco model="env_turb">
  <option timestep="0.001" gravity="0 0 0"/>
  <worldbody>
    <body name="blob" pos="0 0 5">
      <freejoint name="fj"/>
      <geom type="sphere" size="0.05" mass="1" contype="0" conaffinity="0"/>
    </body>
  </worldbody>
  <custom>
    <text name="napl.devices" data='{
      "environments": [{"name": "air", "wind": [20, 0, 0], "w20": 10, "seed": 5, "ref_height": 3.048}]
    }'/>
  </custom>
</mujoco>
