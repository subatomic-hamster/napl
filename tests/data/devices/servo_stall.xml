<!-- Servo against a hard stop: the output joint has a range limit of +-0.3 rad, zero gravity, no current limit,
     max_torque 800 (|duty| <= 0.8). The static output torque is read back from MuJoCo's constraint force. -->
<mujoco model="servo_stall">
  <compiler angle="radian"/>
  <option timestep="0.001" gravity="0 0 0"/>
  <worldbody>
    <body name="link" pos="0 0 0.1">
      <joint name="out" type="hinge" axis="0 0 1" limited="true" range="-0.3 0.3"/>
      <geom type="capsule" fromto="0 0 0 0.1 0 0" size="0.01" mass="0.05" contype="0" conaffinity="0"/>
    </body>
  </worldbody>
  <custom>
    <text name="napl.devices" data='{
      "psus": [{"name": "bench", "node": 1, "voltage": 12, "r_series": 0.05}],
      "servos": [{"name": "s1", "node": 1, "joint": "out",
                  "motor": {"kv": 2100, "r20": 4.4, "i0": 0.05, "rotor_inertia": 5e-8, "w_s": 50, "c_th": 10, "r_th": 15},
                  "gear_ratio": 345, "efficiency": 0.7, "encoder_cpr": 4096, "firmware_hz": 100,
                  "p": 32, "i": 2, "d": 32, "pid_scale": 8192, "deadband": 0, "max_torque": 800}]
    }'/>
  </custom>
</mujoco>
