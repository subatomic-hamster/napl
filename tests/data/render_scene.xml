<mujoco model="render_scene">
  <!-- Every geom type the renderer draws. Static: the geom poses never change. The box face at x = -0.25 is the
       analytic target of the depth and lidar tests; the group-3 geom must stay invisible. -->
  <asset>
    <mesh name="tet" vertex="0 0 0  0.4 0 0  0 0.4 0  0 0 0.4"/>
  </asset>
  <worldbody>
    <geom name="floor" type="plane" size="3 3 0.1" rgba="0.7 0.7 0.75 1"/>
    <geom name="box" type="box" pos="0 0 0.25" size="0.25 0.25 0.25" rgba="0.85 0.2 0.2 1"/>
    <geom name="ball" type="sphere" pos="0.8 0.2 0.2" size="0.2" rgba="0.2 0.75 0.25 1"/>
    <geom name="capsule" type="capsule" pos="-0.7 0.5 0.4" euler="60 20 0" size="0.1 0.2" rgba="0.2 0.4 0.9 1"/>
    <geom name="cylinder" type="cylinder" pos="0.3 -0.8 0.2" size="0.15 0.2" rgba="0.9 0.8 0.2 1"/>
    <geom name="ellipsoid" type="ellipsoid" pos="-0.6 -0.7 0.25" euler="0 0 40" size="0.3 0.15 0.2" rgba="0.7 0.3 0.8 1"/>
    <geom name="mesh" type="mesh" mesh="tet" pos="1.0 -0.6 0.0" rgba="0.1 0.8 0.8 1"/>
    <geom name="hidden" type="box" pos="0 1.5 0.5" size="0.5 0.5 0.5" group="3" rgba="1 1 1 1"/>
  </worldbody>
</mujoco>
